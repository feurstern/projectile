{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Common settings. No generator is set, so CMake uses the CMAKE_GENERATOR environment variable or the platform default (Ninja is recommended).",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with tests.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECTILE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build of the library only.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROJECTILE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release-tests",
      "displayName": "Release with tests",
      "description": "Optimized build with tests (used by CI).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROJECTILE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Debug with sanitizers",
      "description": "Debug build with tests under AddressSanitizer, LeakSanitizer and UndefinedBehaviorSanitizer (GCC or Clang).",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECTILE_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with tests and warnings as errors, for day-to-day development.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECTILE_BUILD_TESTS": "ON",
        "PROJECTILE_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-tests",
      "configurePreset": "release-tests",
      "configuration": "Release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release-tests",
      "inherits": "base",
      "configurePreset": "release-tests",
      "configuration": "Release"
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "configurePreset": "sanitize",
      "configuration": "Debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev",
      "configuration": "Debug"
    }
  ]
}
